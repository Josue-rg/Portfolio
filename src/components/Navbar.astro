---
import profile from '../data/profile';

const navLinks = [
  { href: '#inicio', text: 'Inicio' },
  { href: '#sobre-mi', text: 'Sobre mí' },
  { href: '#habilidades', text: 'Habilidades' },
  { href: '#experiencia', text: 'Experiencia' },
  { href: '#proyectos', text: 'Proyectos' },
];
---

<header class="nav">
  <div class="nav-inner">
    <a href="#inicio" class="wordmark" aria-label="Ir al inicio">
      {profile.name.split(' ')[0]}<span class="dot" aria-hidden="true">.</span>
    </a>

    <nav class="nav-links" aria-label="Navegación principal">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link" data-nav>{link.text}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <button id="theme-toggle" class="theme-btn" type="button" aria-label="Cambiar tema">
        Claro
      </button>

      <a href="#contacto" class="btn btn-sm">Contáctame</a>

      <button
        id="mobile-menu-btn"
        class="menu-btn"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    {navLinks.map((link) => (
      <a href={link.href}>{link.text}</a>
    ))}
    <a href="#contacto">Contacto</a>
  </div>
</header>
