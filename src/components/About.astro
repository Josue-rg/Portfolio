---
import profile from '../data/profile';

const stats = [
  { value: '3+', label: 'Años de experiencia' },
  { value: '20+', label: 'Proyectos completados' },
  { value: '10+', label: 'Clientes satisfechos' },
  { value: '∞', label: 'Ganas de aprender' },
];

const [lead, ...rest] = profile.about;
---

<section id="sobre-mi" class="section">
  <div class="container">
    <h2 class="sr-only">Sobre mí</h2>

    <div class="about-grid">
      <div class="about-side reveal">
        <ul class="stats">
          {stats.map((stat) => (
            <li class="stat">
              <span class="stat-num">{stat.value}</span>
              <span class="stat-label">{stat.label}</span>
            </li>
          ))}
        </ul>

        <figure class="about-photo">
          <img
            src="/images/atmosphere/stats.jpg"
            alt=""
            width="900"
            height="900"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <div class="about-main">
        <p class="about-lead reveal">{lead}</p>
        {rest.map((paragraph, index) => (
          <p class="about-text reveal" style={`--d:${(index + 1) * 90}ms`}>
            {paragraph}
          </p>
        ))}
      </div>
    </div>
  </div>
</section>
