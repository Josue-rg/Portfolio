---
import profile from '../data/profile';

const nameWords = profile.name.trim().split(/\s+/);
const lineOne = nameWords.slice(0, 2).join(' ');
const lineTwo = nameWords.slice(2).join(' ');

const stack = [
  'React',
  'TypeScript',
  'Node.js',
  'Python',
  'Figma',
  'AWS',
  'Docker',
  'Next.js',
  'Tailwind',
  'PostgreSQL',
  'GraphQL',
  'Git',
];
---

<section id="inicio" class="hero">
  <img
    class="hero-bg"
    src="/images/atmosphere/band.jpg"
    alt=""
    width="2400"
    height="1350"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-inner">
    <h1 class="hero-name">
      {lineOne}<br />{lineTwo}
    </h1>

    <div class="hero-grid">
      <p class="hero-tagline">{profile.tagline}</p>

      <div class="hero-side">
        <p class="hero-title">{profile.title}</p>

        <div class="hero-actions">
          <a href="#proyectos" class="btn">
            Ver proyectos
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href="#contacto" class="link-quiet">Contáctame</a>
        </div>
      </div>
    </div>

    <p class="hero-stack">{stack.join('  ·  ')}</p>
  </div>
</section>
