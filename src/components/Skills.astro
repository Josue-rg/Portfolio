---
import profile from '../data/profile';
---

<section id="habilidades" class="section section--field">
  <div class="container">
    <div class="skills-grid">
      <h2 class="section-head reveal">Habilidades</h2>

      <ul class="skills-list">
        {profile.skills.map((skill, index) => (
          <li class="skill-row reveal" style={`--d:${index * 60}ms`}>
            <span class="skill-name">{skill.name}</span>
            <span class="skill-level">
              {skill.level}<span aria-hidden="true">%</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
