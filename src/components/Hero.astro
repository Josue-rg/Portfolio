---
import profile from '../data/profile';
---

<section id="inicio" class="min-h-screen flex items-center pt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <!-- Texto principal -->
      <div class="animate-fade-in">
        <p class="text-primary font-medium mb-4">¡Hola! Soy</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4">
          {profile.name}
        </h1>
        <h2 class="text-2xl md:text-3xl text-text-muted dark:text-gray-400 mb-6">
          {profile.title}
        </h2>
        <p class="text-lg text-text-muted dark:text-gray-400 mb-8 leading-relaxed">
          {profile.tagline}
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="#proyectos" class="btn-primary">
            Ver Proyectos
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="#contacto" class="btn-secondary">
            Contáctame
          </a>
        </div>
      </div>

      <!-- Imagen de perfil (placeholder) -->
      <div class="flex justify-center md:justify-end">
        <div class="relative">
          <div class="w-64 h-64 md:w-80 md:h-80 rounded-full bg-gradient-to-br from-primary to-blue-400 flex items-center justify-center">
            <span class="text-6xl md:text-8xl text-white font-bold">
              {profile.name.split(' ').map(n => n[0]).join('').slice(0, 2)}
            </span>
          </div>
          <!-- Elemento decorativo -->
          <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-primary/20 rounded-full blur-xl"></div>
          <div class="absolute -top-4 -left-4 w-16 h-16 bg-blue-400/20 rounded-full blur-xl"></div>
        </div>
      </div>
    </div>

    <!-- Indicador de scroll -->
    <div class="flex justify-center mt-16">
      <a href="#sobre-mi" class="animate-bounce">
        <svg class="w-6 h-6 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Carrusel de tecnologías -->
  <div class="absolute bottom-0 left-0 right-0 border-t border-gray-100 dark:border-slate-800/50 py-4 overflow-hidden bg-white/50 dark:bg-slate-900/30 backdrop-blur-sm">
    <div class="marquee-track">
      {['React', 'TypeScript', 'Node.js', 'Python', 'Figma', 'AWS', 'Docker', 'Next.js', 'Tailwind', 'PostgreSQL', 'GraphQL', 'Git', 'React', 'TypeScript', 'Node.js', 'Python', 'Figma', 'AWS', 'Docker', 'Next.js', 'Tailwind', 'PostgreSQL', 'GraphQL', 'Git'].map((tech) => (
        <span class="mx-6 text-sm text-gray-400 dark:text-slate-500 whitespace-nowrap flex items-center gap-6">
          <span class="w-1.5 h-1.5 rounded-full bg-primary/60 inline-block"></span>
          {tech}
        </span>
      ))}
    </div>
  </div>
</section>
