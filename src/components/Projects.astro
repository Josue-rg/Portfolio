---
import profile from '../data/profile';

const projects = profile.projects;

function cleanTech(project: (typeof projects)[number]) {
  return project.technologies.map((tech) => tech.trim()).filter(Boolean);
}

function linksFor(project: (typeof projects)[number]) {
  return {
    demo: project.liveUrl || '',
    code: project.githubUrl || '',
  };
}

const entryLink = (project: (typeof projects)[number]) =>
  project.liveUrl || project.githubUrl || '#proyectos';
---

<section id="proyectos" class="section section--field">
  <div class="container">
    <h2 class="section-head reveal">Proyectos</h2>

    <div class="work-grid">
      <div class="work-column">
        <ol class="work-list" id="projects-list" data-list data-page-size="3">
          {projects.map((project, index) => {
            const tech = cleanTech(project);
            const links = linksFor(project);

            return (
              <li class="work-entry reveal" data-item style={`--d:${index * 40}ms`}>
                <a
                  class="work-item"
                  href={entryLink(project)}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-work={index}
                >
                  <span class="work-name">{project.title}</span>
                </a>

                <div class="work-inline">
                  <div class="work-links">
                    {links.demo && (
                      <a href={links.demo} target="_blank" rel="noopener noreferrer">Ver demo</a>
                    )}
                    {links.code && (
                      <a href={links.code} target="_blank" rel="noopener noreferrer">Código</a>
                    )}
                  </div>
                  <p class="work-inline-desc">
                    {project.description}
                    {tech.length > 0 ? ` — ${tech.join(' · ')}` : ''}
                  </p>
                </div>
              </li>
            );
          })}
        </ol>

        <button
          class="more-btn"
          type="button"
          data-more
          aria-controls="projects-list"
          aria-expanded="false"
          data-more-label="Ver más proyectos"
          data-less-label="Ver menos"
          hidden
        >
          <span data-more-text>Ver más proyectos</span>
          <svg
            class="chev"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>

      <aside class="work-preview">
        <div class="work-frame">
          {projects.map((project, index) => {
            const tech = cleanTech(project);
            const links = linksFor(project);

            return (
              <div class="work-panel" data-panel={index}>
                <span class="work-mono" aria-hidden="true">
                  {project.title.trim().charAt(0)}
                </span>
                <p class="work-desc">{project.description}</p>
                {tech.length > 0 && (
                  <ul class="work-tech">
                    {tech.map((item) => <li>{item}</li>)}
                  </ul>
                )}
                <div class="work-links">
                  {links.demo && (
                    <a href={links.demo} target="_blank" rel="noopener noreferrer">Ver demo</a>
                  )}
                  {links.code && (
                    <a href={links.code} target="_blank" rel="noopener noreferrer">Código</a>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </aside>
    </div>
  </div>
</section>
