---
import profile from '../data/profile';

const year = new Date().getFullYear();
---

<footer id="contacto">
  <section class="contact">
    <img
      class="contact-bg"
      src="/images/atmosphere/contact.jpg"
      alt=""
      width="2400"
      height="1350"
      loading="lazy"
      decoding="async"
    />
    <div class="contact-scrim" aria-hidden="true"></div>

    <div class="container contact-inner">
      <div class="contact-card reveal">
        <h2 class="contact-title">¿Trabajamos juntos?</h2>
        <p>
          Estoy disponible para nuevos proyectos y oportunidades. Si tienes en mente algo,
          ¡hablemos!
        </p>

        <a href={`mailto:${profile.social.email}`} class="btn">Enviar email</a>

        <div class="contact-links">
          {profile.social.github && (
            <a href={profile.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          )}
          {profile.social.linkedin && (
            <a href={profile.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          )}
          <a href={`mailto:${profile.social.email}`}>{profile.social.email}</a>
        </div>
      </div>
    </div>
  </section>

  <div class="footer-line">
    <p>Portafolio de {profile.name}</p>

    <nav class="footer-nav" aria-label="Navegación del pie">
      <a href="#inicio">Inicio</a>
      <a href="#sobre-mi">Sobre mí</a>
      <a href="#proyectos">Proyectos</a>
      <a href="#contacto">Contacto</a>
    </nav>

    <p class="footer-right">
      © {year} · Todos los derechos reservados<br />
      Astro + Tailwind CSS
    </p>
  </div>
</footer>
