---
import profile from '../data/profile';
---

<section id="experiencia" class="section">
  <div class="container">
    <h2 class="section-head reveal">Experiencia</h2>

    <div class="exp-list" id="experience-list" data-list data-page-size="3">
      {profile.experience.map((job, index) => (
        <article class="exp-grid reveal" data-item style={`--d:${index * 80}ms`}>
          <p class="exp-period">{job.period}</p>

          <div>
            <h3 class="exp-position">{job.position}</h3>
            <p class="exp-company">{job.company}</p>
            <p class="exp-desc">{job.description}</p>
          </div>
        </article>
      ))}
    </div>

    <button
      class="more-btn"
      type="button"
      data-more
      aria-controls="experience-list"
      aria-expanded="false"
      data-more-label="Ver más experiencia"
      data-less-label="Ver menos"
      hidden
    >
      <span data-more-text>Ver más experiencia</span>
      <svg
        class="chev"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</section>

<div class="band" aria-hidden="true">
  <img
    src="/images/atmosphere/city.jpg"
    alt=""
    width="2400"
    height="1350"
    loading="lazy"
    decoding="async"
  />
</div>
