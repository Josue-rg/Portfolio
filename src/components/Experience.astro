---
import profile from '../data/profile';
---

<section id="experiencia" class="section">
  <div class="max-w-6xl mx-auto">
    <h2 class="section-title">Experiencia</h2>
    
    <div class="relative border-l-2 border-gray-200 dark:border-slate-700 ml-4 space-y-8">
      {profile.experience.map((exp) => (
        <div class="relative pl-8">
          <!-- Punto de la línea de tiempo -->
          <div class="absolute -left-2 top-0 w-4 h-4 bg-primary rounded-full border-4 border-white dark:border-slate-900"></div>
          
          <div class="card">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
              <div>
                <h3 class="text-xl font-bold">{exp.position}</h3>
                <p class="text-primary font-medium">{exp.company}</p>
              </div>
              <span class="text-sm text-text-muted bg-gray-100 dark:bg-slate-800 px-3 py-1 rounded-full">
                {exp.period}
              </span>
            </div>
            <p class="text-text-muted dark:text-gray-400">
              {exp.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
